{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsxImportSource": "@aetheris/i18n",
    "baseUrl": ".",
    "paths": {
      "@aetheris/i18n/*": [
        "src/i18n/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
